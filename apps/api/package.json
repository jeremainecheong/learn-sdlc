{
  "name": "@learnsdlc/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "node --experimental-vm-modules test/jest.cjs --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:eval",
    "typecheck:eval": "tsc -p eval/tsconfig.json --noEmit",
    "test:eval": "node --experimental-vm-modules test/jest.cjs -c eval/jest.config.js --runInBand",
    "user:set-password": "node dist/cli/set-password.js",
    "db:migrate": "node dist/cli/migrate.js",
    "db:migrate:dev": "ts-node src/cli/migrate.ts",
    "content:check": "ts-node src/cli/content-check.ts",
    "starter-archive:write": "ts-node test/cli/starter-archive.ts --write",
    "starter-archive:check": "ts-node test/cli/starter-archive.ts --check",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/db/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1131.0",
    "@aws-sdk/client-lambda": "^3.1116.0",
    "@learnsdlc/shared": "1.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@sentry/node": "^10.73.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1175.0",
    "@aws-sdk/credential-provider-ini": "^3.973.31",
    "@nestjs/testing": "^12.0.1",
    "@smithy/signature-v4": "^5.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "^24.9.0 || >=26.0.0"
  }
}
