# Copy this to .env, or export the ones you need. Every value below is the
# default, so the application starts with none of them set.

# Where the API keeps its data. ":memory:" is honoured, which is what the test
# suite uses; a path is created when it is missing, along with its directory.
TASKTRACKR_DB=./tasktrackr.db

# The port the API listens on. The live preview sets this itself, which is why
# api/main.py reads it rather than hard-coding 8000.
PORT=8000

# The interface the API binds. Loopback by default, because a development
# server should not be reachable from the room; api/Dockerfile sets 0.0.0.0,
# which is where binding every interface is both necessary and safe.
HOST=127.0.0.1

# Where web/serve.js sends anything under /api. Inside a compose network a
# service is reachable by its own name — "http://api:8000" — and never by
# localhost, which inside a container means the container itself.
API_URL=http://127.0.0.1:8000
