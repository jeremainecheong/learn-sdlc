# LearnSDLC configuration. Only OPENAI_API_KEY is required to run locally;
# everything else is optional in development. A commented line shows the value
# used when the variable is unset where there is one, and otherwise a
# placeholder to replace (host names, addresses, keys). For production,
# docs/configuration.md says which of these are required and which
# container reads each one. docker compose reads this file as .env, so every
# active line here also reaches docker-compose.yml.

# ── Public hostnames (compose TLS edge: caddy + web build) ───────────────────
# Caddy issues TLS certificates for both, so DNS must point here first.
# Local trial without DNS: SITE_HOST=localhost API_HOST=api.localhost
# SITE_HOST=learn.example.edu
# API_HOST=api.example.edu
# ACME_EMAIL=ops@example.edu       # certificate-authority contact; defaults to admin@$SITE_HOST

# ── Server ───────────────────────────────────────────────────────────────────
API_PORT=4000
# Origins allowed to call the API with credentials (comma-separated). Unset:
# http://localhost:3000 natively, https://$SITE_HOST under docker compose.
# npm run demo derives it from WEB_PORT.
# WEB_ORIGIN=http://localhost:3000
# Which address the API listens on. Default 127.0.0.1: reachable from this
# machine and from nowhere else, which is what makes the zero-configuration
# start safe. Hosting a class means API_BIND=0.0.0.0, and the API then refuses
# to boot with the local runner or without a real JWT_SECRET, and seeds no demo
# accounts. Under docker compose the api container sets it to 0.0.0.0 itself.
# API_BIND=0.0.0.0
# The secret every session is signed with. The API refuses to start without
# one. Deliberately empty here, because any value published in this file
# would be no secret at all: scripts/setup.sh generates one into your .env
# (npm run demo runs it), and never replaces it once it is there. Elsewhere:
#   JWT_SECRET=$(openssl rand -base64 48)
# Under 32 bytes, or one of the placeholders this repository ships, is refused
# wherever anything but this machine can reach the API.
JWT_SECRET=
# The key quiz papers are drawn and option tokens minted with, JWT_SECRET when
# unset; setting or changing it redraws every open paper once, and after that
# JWT_SECRET can be changed without redrawing them. When set, the JWT_SECRET
# rule above (32 bytes, no placeholder) applies to it too.
# QUIZ_SEED_SECRET=
# JWT_EXPIRES_IN=7d                # session lifetime; the compose api service reads it
TRUSTED_PROXIES=0                  # proxy hops in front of the API: 1 behind Caddy, 0 when directly exposed
# SIGNIN_MAX_PER_ADDRESS=200       # sign-in attempts a minute from one address, across
#                                  # every account: a class shares one venue NAT. One
#                                  # account from one address is still held to 30 a
#                                  # minute, so this is the brake on a scripted loop,
#                                  # not the guard on a password. Means nothing unless
#                                  # TRUSTED_PROXIES is right.
# Password hashing runs on a bounded queue of its own, apart from the request
# and AI limits. A value outside its range refuses the boot.
# PASSWORD_WORK_QUEUE_LIMIT=64     # hashes that may wait at once, 1 to 128
# PASSWORD_WORK_TIMEOUT_MS=30000   # longest one hash may wait and run, 1000 to 60000
# PASSWORD_WORK_IDLE_MS=30000      # idle time before the hashing worker stops, 1000 to 60000

# ── Database: SQLite file by default; set DATABASE_URL for PostgreSQL ────────
DB_PATH=data/learnsdlc.sqlite
# DATABASE_URL=postgres://learnsdlc:${POSTGRES_PASSWORD}@postgres:5432/learnsdlc
# POSTGRES_PASSWORD=               # docker-compose.yml's database password, required there
#                                  # (openssl rand -hex 24: it goes into DATABASE_URL); the
#                                  # local stack generates its own in .env.verify
# Apply versioned migrations at boot instead of schema auto-sync. Implied by
# NODE_ENV=production, and set by npm run demo and scripts/start.sh; set false
# only on replicas after a one-shot migration (runbook §6). Never auto-sync
# against real data.
# RUN_MIGRATIONS=true
# RETENTION_FIRST_SWEEP_DELAY_MS=7200000  # milliseconds after a start before the first
#                                  # daily sweep (month-old mentor cache rows, reset
#                                  # copies past a task's newest three); 0 sweeps at
#                                  # once, anything but a whole number keeps two hours

# ── Job queue ────────────────────────────────────────────────────────────────
# With REDIS_URL grading jobs survive a restart and workers scale horizontally;
# without it an in-process queue is used and interrupted jobs are reconciled
# to a clear failure on boot. REDIS_URL also enables the socket.io Redis
# adapter so job events reach a learner connected to a different replica, and
# backs the per-route rate limits so N replicas share one limit instead of
# allowing N × max. With it unset run a single API replica (REST polling still
# works, and the limits hold per process).
# REDIS_URL=redis://localhost:6379
# JOB_CONCURRENCY=                 # grading/run JOBS one API process works on at
#                                  # once. Default: one below the host's
#                                  # parallelism, floor 2. docker-compose.yml sets
#                                  # 2 and the local Compose stack 1; a container
#                                  # sized for N workers should set N.
JOB_ATTEMPTS=3                     # retries per job before it is marked failed
# RUNNER_SLOTS=                    # sandbox children that may exist at once, across
#                                  # queued grading AND the deployment drill's
#                                  # request-path runs. Default JOB_CONCURRENCY + 2;
#                                  # docker-compose.yml sets 4 and the local Compose
#                                  # stack 2. Size the runner container for this ×
#                                  # RUN_MEMORY_MB. A host with 24 isolated runner
#                                  # slots sets 24, never more than it has.
# GRADING_RUN_FANOUT=              # sandbox runs one submission's review may hold at
#                                  # once. Any whole number from 1 to RUNNER_SLOTS is
#                                  # accepted; anything else (0, a fraction, an empty
#                                  # value, more than RUNNER_SLOTS) refuses the boot.
#                                  # Unset (default): one run after another, then the
#                                  # mutant runs together. A value below RUNNER_SLOTS
#                                  # narrows the Testing mutant wave (it can be slower
#                                  # than unset), so set it equal to RUNNER_SLOTS, or
#                                  # to RUNNER_SLOTS / JOB_CONCURRENCY when several
#                                  # reviews run at once: with RUNNER_SLOTS=24 and
#                                  # JOB_CONCURRENCY=3, GRADING_RUN_FANOUT=8.
# GRADING_SPECULATIVE_MUTANTS=off  # off (default) | on: start a Testing review's mutant
#                                  # runs beside its reference runs. Their results are
#                                  # read only when every reference run passed; on
#                                  # needs GRADING_RUN_FANOUT; any other value refuses
#                                  # the boot.
# SUBMIT_IN_FLIGHT_PER_LEARNER=2   # queued-or-running submissions one learner may hold
#                                  # across every phase and task. ADVISORY: a bare count
#                                  # with no lock behind it, so it may be exceeded by one.
#                                  # The database guarantee is one in-flight submission
#                                  # per (phase state, task), and that one is exact.
# RUNNER_MAX_WAIT_MS=120000        # longest a caller waits for a sandbox slot before
#                                  # being told the runner is busy (503, work saved,
#                                  # no attempt spent). The runner reads it too.
# RUNNER_MAX_WAITING=200           # how many may wait for a slot at once
# RUNNER_QUEUE_DEPTH=              # jobs that may wait for a runner slot at once
#                                  # INSIDE the runner service, default four per
#                                  # slot (at least 8). Each waiter is a thread in a
#                                  # container whose pids_limit (docker-compose.yml)
#                                  # also covers every sandbox child, so raise both
#                                  # together or neither.
# RUNNER_TRANSPORT_ALLOWANCE_SECONDS=0  # socket runner only: extra seconds the API
#                                  # waits for an answer beyond a run's own time limit,
#                                  # for a runner reached over a slower transport; a
#                                  # whole number from 0 to 120, anything else refuses
#                                  # the boot

# ── Accounts ─────────────────────────────────────────────────────────────────
# First admin. Required in production. Read once, on the first boot with no
# ADMIN account; inert afterwards (a settings row 'bootstrap.admin' records
# it). Must be an address nobody has registered. The password is held to
# registration's rules (8 to 100 characters, not a common password); a refused
# one creates no admin, and npm run host refuses it before it starts anything.
# ADMIN_EMAIL=you@your-institution.edu
# ADMIN_PASSWORD=<a strong password>
# The demo staff accounts (instructor@ and admin@learnsdlc.test). Their
# passwords are printed in the README, so they are created only when asked for
# by name and only while the API is bound to loopback, and wherever the network
# can reach the API those passwords are refused at sign-in. scripts/start.sh
# sets this for the local demo; a hosted class must not.
# SEED_DEMO_ACCOUNTS=true
# SEED_PASSWORD=                   # one password for both demo staff accounts, in place
#                                  # of the two published ones
# SITE_URL=                        # origin recovery/verification links point at; defaults to the first WEB_ORIGIN

# ── Sign in with Google ──────────────────────────────────────────────────────
# Optional, and both halves are needed: without the id and the secret the
# sign-in page draws no button and /auth/google refuses, so a deployment can
# ignore this block entirely.
# Create an OAuth client (Web application) in Google Cloud console →
# APIs & Services → Credentials, and register the callback below as an
# authorised redirect URI. docs/production-runbook.md, "Sign in with Google",
# says what turning it on changes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match a redirect URI on the OAuth client exactly. Defaults to this
# API's own origin: http://localhost:4000/api/v1/auth/google/callback.
# GOOGLE_REDIRECT_URL=https://api.example.edu/api/v1/auth/google/callback
# API_PUBLIC_URL=                  # this API's public origin, when only the default redirect needs it
# Addresses Google sign-in accepts, comma-separated and without the "@".
# Empty means any address Google will vouch for; set it for a class.
# ALLOWED_EMAIL_DOMAINS=example.edu

# ── Managed sign-in (Cognito) ────────────────────────────────────────────────
# Optional. AUTH_PROVIDER=local (the default) keeps accounts in this database.
# Choose cognito only with a user pool, app client and hosted domain already
# provisioned and their triggers configured; the API checks the values below
# at boot and refuses an incomplete set.
# AUTH_PROVIDER=local
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=
# COGNITO_REDIRECT_URL=
# COGNITO_PROVIDERS=               # comma-separated provider ids enabled on the app client
# COGNITO_MIGRATION_SECRET=        # 32-byte lowercase hex key shared with the migration trigger

# ── Learner-code runner ──────────────────────────────────────────────────────
# RUNNER_MODE=local | socket | lambda. Unset resolves to socket: there is no
# implicit local, because local is the one mode that runs a learner's code
# inside this process.
# socket = runner/serve.py behind a UNIX socket: the runner container under
#          compose, and a plain Python process on a laptop (scripts/start.sh
#          starts one and points RUNNER_SOCKET at it). The default.
# lambda = the runner Lambda function (scripts/localstack-lambda.sh packages it
#          and deploys it to LocalStack, as CI does)
# local  = a constrained subprocess of the API: same uid, same network, same
#          /proc. Refused in production and refused on any non-loopback bind.
# Whatever the mode, learner code runs only where the kernel can confine it
# (Linux with Landlock); elsewhere the runner refuses every Run, Submit and
# Preview.
# RUNNER_MODE=socket
# RUNNER_SOCKET=/run/learnsdlc/runner.sock   # same path in the api and runner containers
RUN_TIMEOUT_SECONDS=15             # wall clock per execution
RUN_MEMORY_MB=256                  # memory per execution
# The interpreters the socket runner and the pre-bake use on a laptop
# (the runner image has its own). PYTHON_BIN is Python 3.11, the version the
# pre-baked layer is built for; NODE_BIN is a Node 22 binary for learner
# JavaScript, apart from the application's Node 24. npm run demo finds both
# (Node 22 through nvm) and sets them; unset, the runner uses these two.
# PYTHON_BIN=python3
# NODE_BIN=node
# SANDBOX_NPROC=64                 # processes one job may add (RLIMIT_NPROC headroom)
# SANDBOX_LANDLOCK=                # 0 turns the kernel fence off for a test; the runner
#                                  # then refuses learner code. Leave it unset.
# The sandbox's pre-baked dependency layer: Flask, pytest, React, jsdom and one
# esbuild binary, on disk before the first job arrives because a graded run has
# no network and no package manager. Built by `node scripts/prebake.mjs build`
# into apps/api/runner/runtime (gitignored) and baked into the runner image at
# /runner/runtime. Unset resolves to the directory beside the runner's own
# source, which is right on a laptop and in the image alike.
# RUNNER_RUNTIME_DIR=apps/api/runner/runtime
# LSDLC_PYLIB, NODE_PATH and ESBUILD_BIN are NOT settable here: the runner
# computes all three from RUNNER_RUNTIME_DIR and refuses them from a job,
# because they name the code a learner's imports resolve against. Nor is
# RUNNER_ISOLATION: only the single-job microVM supervisor sets it, in its own
# fixed environment. LSDLC_FS_ROOTS, LSDLC_PREVIEW_SECONDS, TASKTRACKR_DB and
# RUNNER_IDLE_EXIT_SECONDS are passed between the runner's and the API's own
# processes and are not settings either.
# RUNNER_STARTUP_OWNER_ID=         # the id the boot-time runner probe runs under; a
#                                  # lowercase UUID, else a fresh one each boot
# Live preview (the Run app button). The runner supervises one child per session:
# the learner's own API on a loopback port, with their front end served by the
# runner itself. Off entirely on the Lambda transport, where an app has nowhere
# to keep running.
PREVIEW_ENABLED=true          # the whole feature. Always off on the Lambda transport.
PREVIEW_SESSIONS=2            # live sessions at once (1 by default with RUNNER_MODE=local). 1 on a laptop.
PREVIEW_MEMORY_MB=512         # per session. 256 on a laptop.
PREVIEW_IDLE_SECONDS=300      # no request and no status poll
PREVIEW_MAX_SECONDS=600       # ten minutes, whatever happens
PREVIEW_BOOT_SECONDS=45       # how long the API has to answer its health route
PREVIEW_BUILD_SECONDS=30      # the esbuild bundle
PREVIEW_MAX_BYTES=33554432    # 32 MB served per session
PREVIEW_REQUEST_TIMEOUT_MS=20000
# PREVIEW_SOCKET=               # RUNNER_MODE=local only: the socket the API's own preview
#                               # runner listens on; default preview.sock beside DB_PATH
# RUNNER_LAMBDA_FUNCTION=learnsdlc-code-runner
# AWS_ENDPOINT_URL=http://localhost:4566     # LocalStack only
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=  (LocalStack only; real deployments use the task role)

# ── Content ──────────────────────────────────────────────────────────────────
# CONTENT_DIR=                     # defaults to the repo's content/ directory
# DEFAULT_PROJECT=                 # the project slug a learner with no enrolment and no
#                                  # class assignment gets, on a deployment that ships
#                                  # more than one pack; unset, the project the import
#                                  # flagged as the default

# ── Observability ────────────────────────────────────────────────────────────
# LOG_FORMAT=json                  # json in production (default), pretty locally
# APP_VERSION=                     # image tag or commit; /health/ready and the Sentry release
# SENTRY_DSN=                      # report every 5xx and failed job to Sentry; log-only when unset
# METRICS_TOKEN=                   # bearer for GET /metrics; unset = open in dev, DISABLED in production

# ── AI provider (required) ───────────────────────────────────────────────────
# npm run demo and npm run demo -- --docker refuse to start until
# OPENAI_API_KEY is set here (or in the environment). The mentor, the
# interview, the Agentic assistant, the explanation gate and grading all use
# it; guardrails still apply. Any OpenAI-compatible hosted endpoint works: set
# OPENAI_BASE_URL, OPENAI_MODEL and OPENAI_API_KEY (docs/local-run.md, "Bring
# your own hosted model"). The local Docker stack reads OPENAI_API_KEY,
# OPENAI_BASE_URL, OPENAI_MODEL, OPENAI_REASONING_EFFORT and OPENAI_TIMEOUT_MS
# from this file at every start.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server
# OPENAI_TIMEOUT_MS=20000          # longest one model call may take; the local Compose
#                                  # stack sets 60000. A timeout is reported as an
#                                  # error, never as a passing assessment.
# AI_MAX_CONCURRENCY=4             # model completions this process may have open at once,
#                                  # 1 to 32; docker-compose.yml and the local stack set 1
# AI_CACHE_TTL_HOURS=24            # how long a cached mentor reply is still served
# AI_USAGE_TIMEZONE=Asia/Singapore # local-day boundary for usage diagnostics only
# AI_AGENTIC_EDIT_LIST=off         # off (default) | on | strict: the Agentic proposal asks
#                                  # for an edit list, expanded against the whole
#                                  # workspace and then checked file by file; any
#                                  # other value refuses the boot
# AI_AGENTIC_PAYLOAD=full          # full (default) | trim: trim sends no file twice and,
#                                  # when the request names files, only those and what
#                                  # they import; full is the recommended value; any
#                                  # other value refuses the boot

# ── Outbound mail (password recovery, address verification) ──────────────────
# With SMTP_HOST unset nothing is sent: the log records the recipient and the
# subject only, and the message itself (the live one-hour link included) is
# appended to MAIL_CAPTURE_FILE as one JSON line, or dropped if that is unset.
# scripts/start.sh points it at data/mail.log. Guard that file like a mailbox.
# SMTP_SECURE defaults to true only on port 465; auth only when SMTP_USER is set.
# MAIL_CAPTURE_FILE=data/mail.log
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false                # true for implicit TLS on port 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LearnSDLC <no-reply@example.edu>"   # default "LearnSDLC <no-reply@localhost>"
# MAIL_PREVIEW_URL=                # a loopback inbox the web app may link to (the local
#                                  # Compose stack's Mailpit); anything else is ignored

# ── Backups (compose: backup service) ────────────────────────────────────────
# BACKUP_KEEP_DAYS=14              # daily dumps kept in the pgbackups volume; copy them off-host
# BACKUP_INTERVAL_SECONDS=86400    # how long the sidecar sleeps between dumps
# BACKUP_ONCE=                     # set to anything to take one dump and stop:
#                                  #   docker compose run --rm -e BACKUP_ONCE=1 backup
# BACKUP_DIR=/backups              # where the dumps and metrics.prom go
# BACKUP_KEEP_MIN=3                # sqlite: never prune below this many backups,
#                                  # however old they are (npm run backup)

# ── Moving a class between machines ──────────────────────────────────────────
# The ceiling on one class import, applied to POST /instructor/cohorts/import
# alone; every other route keeps the 4 MB body limit. Accepts 32mb, 512kb or a
# plain byte count. Raising it costs memory rather than disk (the body is
# buffered and JSON.parse allocates roughly twice the text again), so raise the
# api service's mem_limit with it (runbook §7c). A class exported without the
# revision files measures in single-digit megabytes, which is why the default
# is generous enough that nobody should need to.
# IMPORT_MAX_BYTES=32mb

# ── Demo clock (local demonstrations only) ───────────────────────────────────
# Exactly true lets an administrator move this process's clock through
# POST /api/v1/demo/clock, on a non-production API bound to loopback only.
# npm run demo -- --class sets it to replay a class's weeks; nothing else does.
# DEMO_CLOCK=true

# ── Web client (BUILD-time: next build inlines these into the bundle) ────────
# docker compose passes them as build args; changing one needs
# `docker compose up -d --build web`, not a restart. Unset, the API address and
# the site address are http://localhost:4000 and http://localhost:3000 for a
# native build, and https://$API_HOST and https://$SITE_HOST under compose.
# NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical URLs, og:url, the sitemap and robots.txt are built from this, so a
# production build must name its real origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Who is legally responsible for the deployment and where privacy requests
# go; shown on /privacy and /terms. Unset, the pages name a generic
# "LearnSDLC installation operator" and give no contact address, so every
# deployment other people use must set both.
# NEXT_PUBLIC_OPERATOR_NAME="Your institution"
# NEXT_PUBLIC_OPERATOR_EMAIL=privacy@your-institution.edu
